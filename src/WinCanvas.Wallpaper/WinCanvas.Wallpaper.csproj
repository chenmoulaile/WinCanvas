<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 壁纸 / 动态背景服务类库：与 WinCanvas.Core 相同的 WinUI 兼容目标框架 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WinCanvas.Wallpaper</RootNamespace>
    <!-- 关闭对旧式 P/Invoke 分析器的强制告警，Native/NativeMethods 中已按规范手写注释 -->
    <NoWarn>$(NoWarn);CA1401;CA5392</NoWarn>
    <!-- Rendering/BgraSnapshot.cs 的指针级像素拷贝（IMemoryBufferByteAccess 直取 SoftwareBitmap 原生缓冲）需要 unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 内部类型对诊断 / 测试程序集开放（WP1-A：tools/Wp1AHostDiag 挂接验收命令；
         WP4 的 WinCanvas.Wallpaper.Tests 也将按总提示词加入此名单） -->
    <InternalsVisibleTo Include="Wp1AHostDiag" />
    <!-- 内部类型对诊断程序集开放（WP5：tools/Wp5FormatDiag GIF / webp 行为验收命令——
         与 Wp1AHostDiag 同路线，需要访问 internal 的 WallpaperHostWindow / WallpaperHostPump） -->
    <InternalsVisibleTo Include="Wp5FormatDiag" />
    <!-- 内部类型对 App 层开放（WP1-B：WallpaperPreviewController 使用下沉到本项目的
         共享像素快照工具 BitmapSnapshot / BgraSnapshot，规格 B.3 要求预览与宿主共用一份逻辑） -->
    <InternalsVisibleTo Include="WinCanvas.App" />
    <!-- 内部类型对测试程序集开放（WP4）：WallpaperHostWindow 为 internal（服务层专用宿主抽象），
         但其挂接矩形 / DPI 换算纯函数与 PkgWallpaperLoader 的 SafeJoin / DetectComplexScene /
         FindCoverImage 纯逻辑均按总提示词 WP4 用例表要求可单测——保持 internal 不进公共 API。 -->
    <InternalsVisibleTo Include="WinCanvas.Wallpaper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinCanvas.Core：IWallpaperService / IStatusNotifier 接口与模型 -->
    <ProjectReference Include="..\WinCanvas.Core\WinCanvas.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RePKG（git 子模块 ThirdParty/repkg）：Wallpaper Engine .pkg/.tex 解析核心。
         其目标框架为 netstandard2.0（该 TFM 兼容性最好，可被 net8.0-windows 直接引用），
         故按"子模块源码项目引用"集成，而非进程调用或移植解析代码。
         RePKG.Application 提供 PackageReader / TexReader / TexToImageConverter；
         RePKG.Core 提供包与纹理的数据模型。 -->
    <ProjectReference Include="..\..\ThirdParty\repkg\RePKG.Core\RePKG.Core.csproj" />
    <ProjectReference Include="..\..\ThirdParty\repkg\RePKG.Application\RePKG.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图片解码 / 导入缩放（第一层壁纸）：与 RePKG.Application 使用同一版本，
         避免同一依赖出现两个版本 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.9" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinCanvas.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinCanvas.App.ViewModels">

    <!-- 设置页：所有【全局 / 软件级】开关与快捷键都收在这里。
         v0.3.0 之前它们和窗口属性、壁纸库挤在同一页长滚动列表里，
         结果是「想改个快捷键要滚过半屏」，而主功能区又被开关们稀释。

         数据源是主窗口的同一个 MainViewModel（经 ViewModel 依赖属性注入）：
         设置项与界面状态必须只有一份真源，页面只做呈现。 -->
    <ScrollViewer Padding="24,8,24,24">
        <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Stretch">

            <TextBlock Text="设置"
                       Style="{ThemeResource SubtitleTextBlockStyle}" />

            <!-- ===== 通用 ===== -->
            <TextBlock Text="通用"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <!-- 当前权限（WP5 UIPI 预检）：进程启动时检测一次，运行期不变；
                         用户据此判断对管理员窗口操作失败时是否需要提权重启 -->
                    <TextBlock Text="{x:Bind ViewModel.ElevationStatusText}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.8" TextWrapping="Wrap" />

                    <!-- 启动自动恢复（WP3）：关闭后启动 / 刷新均不做恢复动作，档案仍保留 -->
                    <ToggleSwitch Header="启动时自动恢复窗口状态"
                                  IsOn="{x:Bind ViewModel.AutoRestoreOnStartup, Mode=TwoWay}"
                                  AutomationProperties.Name="启动时自动恢复窗口状态与背景" />

                    <!-- 窗口位置记忆（窗口位置记忆工作包）：挂在上面的启动自动恢复之下的独立子开关。
                         关闭时不移动任何窗口，已记住的位置档案保留。 -->
                    <ToggleSwitch Margin="24,0,0,0"
                                  Header="恢复窗口位置与尺寸"
                                  IsOn="{x:Bind ViewModel.RestoreWindowBoundsOnStartup, Mode=TwoWay}"
                                  AutomationProperties.Name="启动恢复时连同窗口的位置与尺寸一起恢复" />
                    <TextBlock Margin="24,0,0,0"
                               Text="开启后，已「记住当前位置」（窗口与壁纸页的按钮，应用真退出时也会自动捕获）的窗口在下次启动时恢复到档案位置与尺寸；最小化 / 最大化窗口自动跳过，档案位置落在所有显示器之外时跳过并提示。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.7" TextWrapping="Wrap" />

                    <!-- 开机自启动（开机自启动工作包）：HKCU Run 键，注册表是单一真源。
                         标准权限可开关；卸载程序会兜底清理该条目。 -->
                    <ToggleSwitch Header="开机自启动"
                                  IsOn="{x:Bind ViewModel.AutoStartEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="登录 Windows 时自动运行 WinCanvas" />
                    <TextBlock Text="开启后写入注册表 HKCU\Software\Microsoft\Windows\CurrentVersion\Run（值名 WinCanvas，带引号的 exe 全路径，标准权限即可）；关闭即删除该条目。开关状态每次启动都从注册表现读——在注册表里手工删除后这里如实显示为关。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.7" TextWrapping="Wrap" />

                    <!-- 隐私遮罩（隐私窗口工作包）：主窗口失焦时自动遮蔽内容，点回窗口立即恢复 -->
                    <ToggleSwitch Header="主窗口失焦显示隐私遮罩"
                                  IsOn="{x:Bind ViewModel.PrivacyOverlayEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="主窗口失去焦点时自动显示隐私遮罩，重新聚焦后恢复" />
                    <TextBlock Text="开启后，本窗口切到后台（含 Alt-Tab 预览）会显示「已进入隐私模式」遮罩，防止旁人窥视；点回本窗口立即恢复。单个窗口的失焦遮蔽请在「窗口与壁纸」页的窗口列表中逐项开启。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.7" TextWrapping="Wrap" />

                    <ToggleSwitch Header="WinTips 提示（NumLock 状态）"
                                  IsOn="{x:Bind ViewModel.WinTipsEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="开启 NumLock 状态提示浮窗" />

                    <ToggleSwitch Header="壁纸声音（默认关闭）"
                                  IsOn="{x:Bind ViewModel.WallpaperAudioEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="允许带音轨的壁纸发声；默认关闭" />
                    <TextBlock Text="{x:Bind ViewModel.AudioHintText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.7" TextWrapping="Wrap" />

                    <ToggleSwitch Header="FPS 性能监控悬浮显示（开发阶段）"
                                  IsOn="{x:Bind ViewModel.FpsOverlayEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="在界面右上角显示渲染帧率" />
                </StackPanel>
            </Border>

            <!-- ===== 全局快捷键 ===== -->
            <TextBlock Text="全局快捷键"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="即使程序在后台或收进托盘，这些组合键也能触发对应功能。点「组合键」按钮后按下新组合即可改键。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.8" TextWrapping="Wrap" />

                    <!-- 捕获态提示条：明确告诉用户「现在按下的键会被记到哪一行」，
                         并提示 Esc 取消 —— 没有这条提示，捕获态看起来像界面卡住 -->
                    <InfoBar IsOpen="{x:Bind ViewModel.IsCapturingHotkey, Mode=OneWay}"
                             Severity="Informational"
                             IsClosable="False"
                             Message="正在录入快捷键：按下组合键（至少含 Ctrl 或 Alt），按 Esc 取消。" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.HotkeyRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HotkeyRowViewModel">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Label}"
                                                   Style="{ThemeResource BodyTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Opacity="0.7" TextWrapping="Wrap" />
                                        <!-- 注册 / 校验失败原因：红字直说，不靠弹窗 -->
                                        <TextBlock Text="{x:Bind Error, Mode=OneWay}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            MinWidth="140"
                                            Command="{x:Bind CaptureCommand}"
                                            AutomationProperties.Name="{x:Bind Label, Mode=OneTime}"
                                            Content="{x:Bind ComboText, Mode=OneWay}" />

                                    <ToggleSwitch Grid.Column="2"
                                                  OnContent="" OffContent=""
                                                  MinWidth="0"
                                                  IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Bind Label, Mode=OneTime}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Bind ViewModel.HotkeyStatusText, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Opacity="0.8" TextWrapping="Wrap" />

                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{x:Bind ViewModel.ResetAllHotkeysCommand}"
                                AutomationProperties.Name="把所有快捷键恢复为默认组合"
                                Content="恢复默认" />
                        <Button Grid.Column="2"
                                Margin="8,0,0,0"
                                Command="{x:Bind ViewModel.ApplyHotkeysCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                AutomationProperties.Name="按当前设置重新注册全部全局快捷键"
                                Content="应用" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 壁纸轮换（壁纸库轮换工作包）===== -->
            <TextBlock Text="壁纸轮换"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <ToggleSwitch Header="定时自动轮换壁纸"
                                  IsOn="{x:Bind ViewModel.WallpaperRotationEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="按设定的间隔自动把壁纸库下一条可用条目挂到所有已挂背景的窗口" />
                    <TextBlock Text="开启后到期自动把下一条可用条目挂到【当前所有已挂背景的窗口】（只动已挂背景的窗口）；一轮内不重复、轮完从头再来；单条挂接失败自动顺延下一条并提示。重启后各窗口恢复到轮换后的最后一张。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.7" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="轮换间隔" VerticalAlignment="Center" />
                        <ComboBox MinWidth="160"
                                  ItemsSource="{x:Bind ViewModel.WallpaperRotationIntervalOptions, Mode=OneTime}"
                                  SelectedItem="{x:Bind ViewModel.WallpaperRotationIntervalMinutes, Mode=TwoWay}"
                                  AutomationProperties.Name="壁纸轮换的间隔（分钟）" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 壁纸库目录（v0.4.0 新增）=====
                 自定义扫描根在这里增删（config 持久化）。自动探测的候选
                 （创意工坊 / 系统主题 / 图片库）不受本列表控制，只读展示在末行。 -->
            <TextBlock Text="壁纸库目录"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="自定义目录会与自动探测的候选（Wallpaper Engine 工坊 / 系统主题壁纸 / 图片库）一起进入「壁纸库」扫描。添加后立即重新检索并持久化，重启后仍生效。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.8" TextWrapping="Wrap" />

                    <!-- 自定义目录行：路径 + 移除（与快捷键行同一套「行对象持有命令」模式） -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.LibraryRootRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WallpaperLibraryRootRow">
                                <Grid Padding="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Path}"
                                               VerticalAlignment="Center"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            Content="移除"
                                            Command="{x:Bind RemoveCommand}"
                                            AutomationProperties.Name="移除该自定义壁纸库目录" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Click="OnAddLibraryRootClick"
                                AutomationProperties.Name="添加一个自定义目录参与壁纸库扫描"
                                Content="添加目录" />
                        <Button Command="{x:Bind ViewModel.ScanLibraryCommand}"
                                IsEnabled="{x:Bind ViewModel.CanScanLibrary, Mode=OneWay}"
                                AutomationProperties.Name="强制重新扫描全部壁纸库目录"
                                Content="检索壁纸库" />
                    </StackPanel>

                    <!-- 自动探测候选（只读）：让用户看清全貌，避免「为什么库里有我没加过的目录」的疑问 -->
                    <TextBlock Text="当前全部扫描根（含自动探测，自动项不可在此移除）："
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.LibraryRootsText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

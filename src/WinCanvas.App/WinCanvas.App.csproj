<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinUI 3 目标框架：Windows 10 19041+ -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinCanvas.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 壁纸预览控制器经 IMemoryBufferByteAccess COM 接口直读 SoftwareBitmap 像素，需要不安全代码 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- WinUI 3 -->
    <UseWinUI>true</UseWinUI>

    <!-- unpackaged（非打包）部署：不依赖 MSIX -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 自带 WinAppSDK 运行时，目标机器无需安装 Windows App Runtime -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- .NET 运行时同样自带。v0.2.0 补上：
         此前只有 WindowsAppSDKSelfContained，CLR 仍是【框架依赖】—— net8 时代本机
         装了 .NET 8 桌面运行时所以没暴露问题；迁到 net10 后 dotnet build 的产物
         双击直接弹「You must install or update .NET to run this application」，
         因为默认安装位置没有 .NET 10 运行时。
         对一个要分发给用户桌面的工具，「装了就能跑、不要求用户先装运行时」
         本来就该是默认；发布产物体积增加有限（原本自包含 WinAppSDK 已经 200MB 级）。 -->
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>

    <!-- WinUI 3 不支持 AnyCPU 产物，骨架阶段固定 x64 -->
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!-- ===== 应用图标（v0.2.0 新增）=====
         exe 文件图标 + 任务栏/alt-tab 图标 + 托盘图标的共同来源。
         迁移前没有任何图标设置：exe 用 VS 默认图标，任务栏是通用窗口图标，
         一个要长期驻留在通知区域的应用却没有可辨识的图标。 -->
    <ApplicationIcon>..\..\assets\icons\WinCanvas.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 随产物发布 .ico：托盘与窗口图标在运行期按 AppContext.BaseDirectory 加载。
         取不到该文件时代码会静默降级（不影响主功能），但界面就没有自定义图标。 -->
    <None Include="..\..\assets\icons\WinCanvas.ico" Link="WinCanvas.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.WindowsAppSDK 1.x 稳定线最新版（2.x 为新大版本，未在本环境对 .NET 8 验证）。
         Microsoft.Windows.SDK.BuildTools 由其传递依赖自动带入（本环境解析为 10.0.26100.4654） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <!-- MVVM 工具库：后续 ViewModel 阶段使用 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinCanvas.Core\WinCanvas.Core.csproj" />
    <!-- 壁纸服务（三层加载策略 + 渲染循环）与 WinTips 集成服务（WinCanvas.Wallpaper 类库） -->
    <ProjectReference Include="..\WinCanvas.Wallpaper\WinCanvas.Wallpaper.csproj" />
  </ItemGroup>

  <!-- ===== WP2：WinTips.exe 外挂构建部署 =====
       WinTips（ThirdParty/WinTips 子模块）是 net10.0-windows 的 WPF 程序，三自研项目是 net8.0 +
       WinUI 3 —— 两代 TFM / 平台配置混入同一 sln 会互相污染，故不把 WinTips 加进 WinCanvas.sln，
       而是在本工程 Build 完成后用 dotnet build 外挂构建（.NET 10 SDK）并把产物拷到 $(OutDir)WinTips\，
       与 WinTipsIntegrationService.TryLocateWinTipsExe 的「程序目录旁 WinTips\WinTips.exe」候选路径天然接上。
       构建失败只告警不阻断：exe 缺失时运行期走既有本地回退通道（InfoBar）。 -->
  <PropertyGroup>
    <!-- WinTips 子模块工程与其默认 Release 输出目录（net10.0-windows，无 RID、无平台子目录） -->
    <WinTipsProject>$(MSBuildThisFileDirectory)..\..\ThirdParty\WinTips\WinTips.csproj</WinTipsProject>
    <WinTipsBuildOutputDir>$(MSBuildThisFileDirectory)..\..\ThirdParty\WinTips\bin\Release\net10.0-windows\</WinTipsBuildOutputDir>

    <!-- 外挂构建用哪个 dotnet 可执行文件。
         v0.2.0 修正：旧写法直接写 `dotnet build`，于是 PATH 上第一个 dotnet 说了算。
         在 SDK 不装在默认位置的开发机上（例如 C 盘空间紧张、SDK 放在别的盘，
         而 C:\Program Files\dotnet 只有运行时没有 SDK）——这条命令必然解析到
         那个【没有 SDK 的 muxer】，外挂构建永远失败，WinTips.exe 永远部署不上，
         NumLock 浮窗提示静默退化成 InfoBar。构建日志里只有一条 warning，很容易漏看。

         $(NetCoreRoot) 是 MSBuild 在 .NET Core 宿主下提供的【当前驱动本次构建的 .NET 根目录】
         （末尾自带分隔符），用它就能保证外挂构建与主构建用同一套 SDK。
         取不到时才退回裸 `dotnet`（默认安装的场景仍然可用）。 -->
    <WinTipsDotnetHost Condition="'$(WinTipsDotnetHost)' == '' And Exists('$(NetCoreRoot)dotnet.exe')">$(NetCoreRoot)dotnet.exe</WinTipsDotnetHost>
    <WinTipsDotnetHost Condition="'$(WinTipsDotnetHost)' == ''">dotnet</WinTipsDotnetHost>
  </PropertyGroup>

  <Target Name="BuildAndDeployWinTips"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(WinTipsProject);$(MSBuildThisFileDirectory)..\..\ThirdParty\WinTips\**\*.cs;$(MSBuildThisFileDirectory)..\..\ThirdParty\WinTips\**\*.xaml"
          Outputs="$(OutDir)WinTips\WinTips.exe">
    <!-- 增量语义（Inputs/Outputs）：子模块源码未变化且 $(OutDir)WinTips\WinTips.exe 存在时整体跳过；
         源码更新或产物被清理后自动重建，避免把过期 exe 留在部署目录。
         子模块缺失时 Inputs 非空但仍跑进来，由下方 Exists 条件与专属告警给出人话提示；
         属性先归零兜底：未真正执行外挂构建时不会误报「构建失败」。 -->
    <PropertyGroup>
      <WinTipsBuildExitCode Condition="'$(WinTipsBuildExitCode)' == ''">0</WinTipsBuildExitCode>
    </PropertyGroup>

    <!-- 1) 外挂构建（.NET 10 SDK）：IgnoreExitCode 使失败不阻断 App 构建，错误码落属性后统一告警。
         用 $(WinTipsDotnetHost) 而不是裸 dotnet，理由见上面属性块的注释。 -->
    <Exec Condition="Exists('$(WinTipsProject)')"
          Command="&quot;$(WinTipsDotnetHost)&quot; build &quot;$(WinTipsProject)&quot; -c Release --nologo"
          IgnoreExitCode="true"
          ConsoleToMsBuild="true"
          StandardOutputImportance="normal"
          StandardErrorImportance="normal"
          Timeout="300000">
      <Output TaskParameter="ExitCode" PropertyName="WinTipsBuildExitCode" />
    </Exec>

    <!-- 2) 构建成功：把 exe 及其依赖（dll / deps.json / runtimeconfig.json / pdb）拷入部署目录 -->
    <ItemGroup Condition="'$(WinTipsBuildExitCode)' == '0'">
      <WinTipsDeployFiles Include="$(WinTipsBuildOutputDir)**\*.*" />
    </ItemGroup>
    <Copy Condition="'$(WinTipsBuildExitCode)' == '0' and '@(WinTipsDeployFiles)' != ''"
          SourceFiles="@(WinTipsDeployFiles)"
          DestinationFiles="@(WinTipsDeployFiles->'$(OutDir)WinTips\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Condition="'$(WinTipsBuildExitCode)' == '0' and '@(WinTipsDeployFiles)' != ''"
             Text="WinTips.exe 已部署到 $(OutDir)WinTips\" Importance="normal" />

    <!-- 3) 失败呈现：给出「失败 + 原因 + 用户能做什么」的明确告警（不阻断构建） -->
    <Warning Condition="'$(WinTipsBuildExitCode)' != '0'"
             Text="WinTips.exe 外挂构建失败（使用 $(WinTipsDotnetHost)，退出码 $(WinTipsBuildExitCode)）：NumLock 浮窗提示将不可用，运行期自动回退主界面 InfoBar 提示；请确认该 dotnet 对应的安装里有 .NET 10 SDK（`$(WinTipsDotnetHost)` --list-sdks 应含 10.0.x）后重新构建。" />
    <Warning Condition="!Exists('$(WinTipsProject)')"
             Text="未找到 WinTips 子模块工程（ThirdParty/WinTips/WinTips.csproj）：请先执行 git submodule update --init 拉取子模块；本次构建不会部署 WinTips.exe，NumLock 提示走本地 InfoBar 回退通道。" />
  </Target>

  <!-- ===== 发布产物修复（v0.1.0 发布包实测缺陷）：dotnet publish 对 unpackaged WinUI 3 有两处遗漏
       ① XAML 编译产物 *.xbf 与应用资源索引 WinCanvas.App.pri 不在发布清单里——缺它们时
          XAML 资源加载失败，应用启动即崩溃（实测事件日志：Microsoft.UI.Xaml.dll
          0xc000027b 存储异常 / combase 80004005 E_FAIL）；
       ② WinTips\ 外挂部署目录只被 BuildAndDeployWinTips 拷到 $(OutDir)，publish 收集器不感知。
       本 Target 在发布清单计算完成后，把这两类产物从 $(OutDir) 追加进 ResolvedFileToPublish。 -->
  <Target Name="IncludeRuntimeArtifactsInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- 1) XAML 编译产物：App/MainWindow 等全部 .xbf（bin 输出根目录） -->
      <_PublishXbfFiles Include="$(OutDir)*.xbf" />
      <ResolvedFileToPublish Include="@(_PublishXbfFiles)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
      </ResolvedFileToPublish>
      <!-- 2) 应用资源索引（.NET 单项目 PRI，名为 WinCanvas.App.pri） -->
      <ResolvedFileToPublish Include="$(OutDir)$(TargetName).pri">
        <RelativePath>$(TargetName).pri</RelativePath>
      </ResolvedFileToPublish>
      <!-- 3) WinTips 外挂部署目录（整体递归） -->
      <_PublishWinTipsFiles Include="$(OutDir)WinTips\**\*.*" />
      <ResolvedFileToPublish Include="@(_PublishWinTipsFiles)">
        <RelativePath>WinTips\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
      </ResolvedFileToPublish>
      <!-- 注：WinCanvas.ico 不在这里加。上面 ItemGroup 里那条
           None + CopyToOutputDirectory 已经会被发布收集器自动收录，
           再手动 Include 一次会撞 NETSDK1152（多个相同相对路径的发布输出文件）。
           实测这条就是 publish 阶段才发现的。 -->
    </ItemGroup>
  </Target>

</Project>

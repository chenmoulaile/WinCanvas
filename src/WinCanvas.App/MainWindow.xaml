<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinCanvas.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinCanvas.App.ViewModels"
    Title="WinCanvas">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏拖拽区（ExtendsContentIntoTitleBar = true 时由 SetTitleBar 挂接） -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <TextBlock Text="WinCanvas"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：窗口列表（贴近 Windows 设置应用的导航窗格） -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="12,4,12,12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WindowListHeader"
                                   Text="窗口列表"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="窗口列表"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="20" Height="20"
                                          IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
                            <!-- 刷新期间禁用按钮：迁移前按钮从不置灰，连点会排入 N 条串行管线 -->
                            <Button Command="{x:Bind ViewModel.RefreshCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    AutomationProperties.Name="重新枚举全部可见窗口"
                                    Content="刷新" />
                        </StackPanel>
                    </Grid>

                    <!-- 窗口搜索框（v0.2.0 新增）：标题 / 进程名 / 类名子串匹配 -->
                    <AutoSuggestBox Grid.Row="1"
                                    x:Name="WindowSearchBox"
                                    PlaceholderText="搜索标题 / 进程 / 类名"
                                    QueryIcon="Find"
                                    Text="{x:Bind ViewModel.WindowFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="按标题、进程名或类名过滤窗口列表" />

                    <ListView Grid.Row="2"
                              SelectionMode="Single"
                              AutomationProperties.LabeledBy="{x:Bind WindowListHeader}"
                              ItemsSource="{x:Bind ViewModel.FilteredWindows, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WindowItemViewModel">
                                <StackPanel Spacing="2" Padding="2">
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{ThemeResource BodyTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Subtitle}"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Opacity="0.7" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 过滤结果为空时的说明：避免「搜索框有字 + 列表空白」被误认为程序坏了 -->
                    <TextBlock Grid.Row="2"
                               Text="没有匹配的窗口"
                               Visibility="{x:Bind ViewModel.EmptyFilterVisibility, Mode=OneWay}"
                               Opacity="0.7"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 右侧：属性面板 -->
            <Grid Grid.Column="1">
                <ScrollViewer Padding="24,8,24,24">
                    <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Stretch">

                        <!-- 全局提示条 -->
                        <InfoBar IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                                 Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                                 Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}" />

                        <!-- 窗口属性 / 壁纸（选中窗口后显示） -->
                        <StackPanel Spacing="12"
                                    Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">

                            <TextBlock Text="窗口属性"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="16">

                                    <!-- 选中窗口信息 -->
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedDisplayName, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSubtitle, Mode=OneWay}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedHwndText, Mode=OneWay}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Opacity="0.7" />
                                    </StackPanel>

                                    <!-- 置顶 / 鼠标穿透 -->
                                    <ToggleSwitch Header="窗口置顶"
                                                  IsOn="{x:Bind ViewModel.SelectedIsTopmost, Mode=TwoWay}" />
                                    <ToggleSwitch Header="鼠标穿透"
                                                  IsOn="{x:Bind ViewModel.SelectedClickThrough, Mode=TwoWay}" />

                                    <!-- 透明度 -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="透明度" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind ViewModel.SelectedAlphaText, Mode=OneWay}"
                                                       Opacity="0.7" />
                                        </Grid>
                                        <Slider Minimum="0" Maximum="255" StepFrequency="1"
                                                Value="{x:Bind ViewModel.SelectedAlpha, Mode=TwoWay}" />
                                    </StackPanel>

                                    <!-- 圆角选择 -->
                                    <RadioButtons Header="圆角"
                                                  MaxColumns="3"
                                                  ItemsSource="{x:Bind ViewModel.CornerOptions, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedCorner, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="壁纸背景"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="为所选窗口设置独立背景（图片 / 视频 / .pkg 打包资源）。"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Opacity="0.8" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Command="{x:Bind ViewModel.PickWallpaperCommand}"
                                                AutomationProperties.Name="选择图片、视频或 pkg 文件作为所选窗口的背景"
                                                Content="选择背景文件…" />
                                        <!-- 清除背景：迁移前没有这个入口，挂上背景只能靠关掉目标窗口摆脱 -->
                                        <Button Command="{x:Bind ViewModel.ClearWallpaperCommand}"
                                                AutomationProperties.Name="移除所选窗口的背景，恢复其自身绘制"
                                                Content="清除背景" />
                                        <ProgressRing Width="24" Height="24"
                                                      IsActive="{x:Bind ViewModel.IsWallpaperLoading, Mode=OneWay}" />
                                    </StackPanel>
                                    <ProgressBar Maximum="100"
                                                 Value="{x:Bind ViewModel.WallpaperProgress, Mode=OneWay}"
                                                 IsIndeterminate="{x:Bind ViewModel.IsWallpaperLoading, Mode=OneWay}" />
                                    <!-- 壁纸画面预览承载：图片帧 → Image 上屏；视频 → MediaPlayerElement 输出。
                                         由 WallpaperPreviewController 在 code-behind 装配接线 -->
                                    <Border Height="200"
                                            CornerRadius="4"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="4">
                                        <Grid>
                                            <Image x:Name="WallpaperPreviewImage"
                                                   Stretch="Uniform" />
                                            <MediaPlayerElement x:Name="WallpaperPreviewPlayer"
                                                                AreTransportControlsEnabled="False"
                                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{x:Bind ViewModel.WallpaperFilePathText, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.WallpaperStatusText, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Opacity="0.8" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 设置区（始终可见） -->
                        <TextBlock Text="设置"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="16">
                                <!-- 当前权限（WP5 UIPI 预检）：进程启动时检测一次，运行期不变；
                                     用户据此判断对管理员窗口操作失败时是否需要提权重启 -->
                                <TextBlock Text="{x:Bind ViewModel.ElevationStatusText}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Opacity="0.8" TextWrapping="Wrap" />
                                <!-- 启动自动恢复（WP3）：关闭后启动 / 刷新均不做恢复动作，档案仍保留 -->
                                <ToggleSwitch Header="启动时自动恢复窗口状态"
                                              IsOn="{x:Bind ViewModel.AutoRestoreOnStartup, Mode=TwoWay}" />
                                <ToggleSwitch Header="WinTips 提示（NumLock 状态）"
                                              IsOn="{x:Bind ViewModel.WinTipsEnabled, Mode=TwoWay}" />
                                <ToggleSwitch Header="FPS 性能监控悬浮显示（开发阶段）"
                                              IsOn="{x:Bind ViewModel.FpsOverlayEnabled, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <!-- ===== 全局快捷键设置（v0.2.0 新增）=====
                             每一项功能都有独立可改的组合键；点按钮后按下新组合即生效。
                             捕获态由主窗口的 KeyDown（handledEventsToo）接收，见 code-behind。 -->
                        <TextBlock Text="全局快捷键"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="即使程序在后台或收进托盘，这些组合键也能触发对应功能。点「组合键」按钮后按下新组合即可改键。"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Opacity="0.8" TextWrapping="Wrap" />

                                <!-- 捕获态提示条：明确告诉用户「现在按下的键会被记到哪一行」，
                                     并提示 Esc 取消 —— 没有这条提示，捕获态看起来像界面卡住 -->
                                <InfoBar IsOpen="{x:Bind ViewModel.IsCapturingHotkey, Mode=OneWay}"
                                         Severity="Informational"
                                         IsClosable="False"
                                         Message="正在录入快捷键：按下组合键（至少含 Ctrl 或 Alt），按 Esc 取消。" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.HotkeyRows, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HotkeyRowViewModel">
                                            <Grid Padding="0,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Label}"
                                                               Style="{ThemeResource BodyTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind Description}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Opacity="0.7" TextWrapping="Wrap" />
                                                    <!-- 注册 / 校验失败原因：红字直说，不靠弹窗 -->
                                                    <TextBlock Text="{x:Bind Error, Mode=OneWay}"
                                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" />
                                                </StackPanel>

                                                <Button Grid.Column="1"
                                                        MinWidth="140"
                                                        Command="{x:Bind CaptureCommand}"
                                                        AutomationProperties.Name="{x:Bind Label, Mode=OneTime}"
                                                        Content="{x:Bind ComboText, Mode=OneWay}" />

                                                <ToggleSwitch Grid.Column="2"
                                                              OnContent="" OffContent=""
                                                              MinWidth="0"
                                                              IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                                              AutomationProperties.Name="{x:Bind Label, Mode=OneTime}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Bind ViewModel.HotkeyStatusText, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Opacity="0.8" TextWrapping="Wrap" />

                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{x:Bind ViewModel.ResetAllHotkeysCommand}"
                                            AutomationProperties.Name="把所有快捷键恢复为默认组合"
                                            Content="恢复默认" />
                                    <Button Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Command="{x:Bind ViewModel.ApplyHotkeysCommand}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            AutomationProperties.Name="按当前设置重新注册全部全局快捷键"
                                            Content="应用" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 未选中窗口时的占位 -->
                        <TextBlock Text="请先在左侧选择一个窗口"
                                   Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"
                                   Margin="0,32,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- FPS 性能监控悬浮显示（右上角） -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,16,0"
                        Padding="12,6"
                        CornerRadius="6"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{x:Bind ViewModel.FpsOverlayVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.FpsText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

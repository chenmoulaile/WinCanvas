<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinCanvas.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:WinCanvas.App.Pages"
    xmlns:vm="using:WinCanvas.App.ViewModels"
    Title="WinCanvas">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏拖拽区（ExtendsContentIntoTitleBar = true 时由 SetTitleBar 挂接） -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <TextBlock Text="WinCanvas"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold" />
        </Grid>

        <!-- ===== 主导航（v0.3.1）=====
             窗口管理 / 设置 / 关于 三页。之前所有东西挤在同一页长滚动列表里，
             想改一个快捷键要滚过半屏，主功能区又被全局开关稀释；
             现在按「做什么」和「怎么配置」分开，关于页独立可查版本与日志位置。

             三页共享同一个 MainViewModel（页面经依赖属性注入），
             设置项不存在第二份状态 —— 快捷键注册、配置持久化仍只有一处真源。 -->
        <NavigationView Grid.Row="1"
                        x:Name="RootNav"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavSelectionChanged"
                        AutomationProperties.Name="主导航">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="窗口与壁纸" Tag="home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="PageHost">

                <!-- ===== 首页：窗口列表 + 属性面板 + 壁纸库 ===== -->
                <Grid x:Name="HomePage">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                    <!-- 左侧：窗口列表（贴近 Windows 设置应用的导航窗格） -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,1,0">
                        <Grid Margin="12,4,12,12" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="WindowListHeader"
                                           Text="窗口列表"
                                           VerticalAlignment="Center"
                                           AutomationProperties.Name="窗口列表"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="20" Height="20"
                                                  IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
                                    <!-- 刷新期间禁用按钮：迁移前按钮从不置灰，连点会排入 N 条串行管线 -->
                                    <Button Command="{x:Bind ViewModel.RefreshCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            AutomationProperties.Name="重新枚举全部可见窗口"
                                            Content="刷新" />
                                </StackPanel>
                            </Grid>

                            <!-- 窗口搜索框（v0.2.0 新增）：标题 / 进程名 / 类名子串匹配 -->
                            <AutoSuggestBox Grid.Row="1"
                                            x:Name="WindowSearchBox"
                                            PlaceholderText="搜索标题 / 进程 / 类名"
                                            QueryIcon="Find"
                                            Text="{x:Bind ViewModel.WindowFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="按标题、进程名或类名过滤窗口列表" />

                            <ListView Grid.Row="2"
                                      SelectionMode="Single"
                                      AutomationProperties.LabeledBy="{x:Bind WindowListHeader}"
                                      ItemsSource="{x:Bind ViewModel.FilteredWindows, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WindowItemViewModel">
                                        <StackPanel Spacing="2" Padding="2">
                                            <TextBlock Text="{x:Bind DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{ThemeResource BodyTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Subtitle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Opacity="0.7" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 过滤结果为空时的说明：避免「搜索框有字 + 列表空白」被误认为程序坏了 -->
                            <TextBlock Grid.Row="2"
                                       Text="没有匹配的窗口"
                                       Visibility="{x:Bind ViewModel.EmptyFilterVisibility, Mode=OneWay}"
                                       Opacity="0.7"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 右侧：属性面板 -->
                    <Grid Grid.Column="1">
                        <ScrollViewer Padding="24,8,24,24">
                            <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Stretch">

                                <!-- 全局提示条 -->
                                <InfoBar IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                                         Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                                         Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}" />

                                <!-- 窗口属性 / 壁纸（选中窗口后显示） -->
                                <StackPanel Spacing="12"
                                            Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">

                                    <TextBlock Text="窗口属性"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8" Padding="16">
                                        <StackPanel Spacing="16">

                                            <!-- 选中窗口信息 -->
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedDisplayName, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSubtitle, Mode=OneWay}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedHwndText, Mode=OneWay}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Opacity="0.7" />
                                            </StackPanel>

                                            <!-- 置顶 / 鼠标穿透 -->
                                            <ToggleSwitch Header="窗口置顶"
                                                          IsOn="{x:Bind ViewModel.SelectedIsTopmost, Mode=TwoWay}" />
                                            <ToggleSwitch Header="鼠标穿透"
                                                          IsOn="{x:Bind ViewModel.SelectedClickThrough, Mode=TwoWay}" />

                                            <!-- 透明度 -->
                                            <StackPanel Spacing="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="透明度" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind ViewModel.SelectedAlphaText, Mode=OneWay}"
                                                               Opacity="0.7" />
                                                </Grid>
                                                <Slider Minimum="0" Maximum="255" StepFrequency="1"
                                                        Value="{x:Bind ViewModel.SelectedAlpha, Mode=TwoWay}" />
                                            </StackPanel>

                                            <!-- 圆角选择 -->
                                            <RadioButtons Header="圆角"
                                                          MaxColumns="3"
                                                          ItemsSource="{x:Bind ViewModel.CornerOptions, Mode=OneWay}"
                                                          SelectedItem="{x:Bind ViewModel.SelectedCorner, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="壁纸背景"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8" Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="为所选窗口设置独立背景（图片 / 视频 / .pkg 打包资源）。"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Opacity="0.8" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Button Command="{x:Bind ViewModel.PickWallpaperCommand}"
                                                        AutomationProperties.Name="选择图片、视频或 pkg 文件作为所选窗口的背景"
                                                        Content="选择背景文件…" />
                                                <!-- 清除背景：迁移前没有这个入口，挂上背景只能靠关掉目标窗口摆脱 -->
                                                <Button Command="{x:Bind ViewModel.ClearWallpaperCommand}"
                                                        AutomationProperties.Name="移除所选窗口的背景，恢复其自身绘制"
                                                        Content="清除背景" />
                                                <ProgressRing Width="24" Height="24"
                                                              IsActive="{x:Bind ViewModel.IsWallpaperLoading, Mode=OneWay}" />
                                            </StackPanel>
                                            <ProgressBar Maximum="100"
                                                         Value="{x:Bind ViewModel.WallpaperProgress, Mode=OneWay}"
                                                         IsIndeterminate="{x:Bind ViewModel.IsWallpaperLoading, Mode=OneWay}" />
                                            <!-- 壁纸画面预览承载：图片帧 → Image 上屏；视频 → MediaPlayerElement 输出。
                                                 由 WallpaperPreviewController 在 code-behind 装配接线 -->
                                            <Border Height="200"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="4">
                                                <Grid>
                                                    <Image x:Name="WallpaperPreviewImage"
                                                           Stretch="Uniform" />
                                                    <MediaPlayerElement x:Name="WallpaperPreviewPlayer"
                                                                        AreTransportControlsEnabled="False"
                                                                        Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{x:Bind ViewModel.WallpaperFilePathText, Mode=OneWay}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ViewModel.WallpaperStatusText, Mode=OneWay}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Opacity="0.8" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ===== 壁纸库（v0.3.0 新增：自动检索 Wallpaper Engine 项目）===== -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="壁纸库"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <ProgressRing Width="20" Height="20"
                                                      IsActive="{x:Bind ViewModel.IsLibraryScanning, Mode=OneWay}" />
                                        <Button Click="OnAddLibraryRootClick"
                                                AutomationProperties.Name="添加一个 Wallpaper Engine 项目目录作为扫描根"
                                                Content="添加目录" />
                                        <Button Command="{x:Bind ViewModel.ScanLibraryCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanScanLibrary, Mode=OneWay}"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                AutomationProperties.Name="扫描全部已配置目录并列出可挂接壁纸"
                                                Content="检索壁纸库" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="自动检索 Wallpaper Engine（创意工坊与本地项目）、系统主题壁纸、「图片」库，以及自定义目录里散落的图片 / 视频 / .pkg。每条带来源标签；选中一个窗口后点条目即可挂接。"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Opacity="0.8" TextWrapping="Wrap" />

                                        <!-- 扫描根列表：让用户看清「在哪些目录里找」，带来源前缀 -->
                                        <TextBlock Text="{x:Bind ViewModel.LibraryRootsText, Mode=OneWay}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Opacity="0.7" TextWrapping="Wrap" />

                                        <TextBox PlaceholderText="按标题 / 类型 / 来源过滤壁纸…"
                                                 Text="{x:Bind ViewModel.LibraryFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="过滤壁纸库条目" />

                                        <!-- 扫描进度（v0.4.0）：ProgressRing 之外补一条文字进度，
                                             让「扫到第几个目录、发现了多少」可见 -->
                                        <TextBlock Text="{x:Bind ViewModel.LibraryProgressText, Mode=OneWay}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Opacity="0.8" TextWrapping="Wrap"
                                                   AutomationProperties.Name="壁纸库扫描进度" />

                                        <!-- 库条目：虚拟化 GridView，缩略图按视口延迟解码 -->
                                        <GridView MaxHeight="360"
                                                  IsItemClickEnabled="True"
                                                  SelectionMode="None"
                                                  ItemClick="OnLibraryItemClick"
                                                  ItemsSource="{x:Bind ViewModel.FilteredLibraryItems, Mode=OneWay}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WallpaperLibraryItemViewModel">
                                                    <Grid Width="150" Padding="6" RowSpacing="4"
                                                          Loaded="OnLibraryItemLoaded">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Border Height="76" CornerRadius="4"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                            <Grid>
                                                                <!-- 无预览图时的类型占位 -->
                                                                <TextBlock Text="{x:Bind KindLabel}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Opacity="0.5" Style="{ThemeResource CaptionTextBlockStyle}" />
                                                                <Image Source="{x:Bind Preview, Mode=OneWay}"
                                                                       Stretch="UniformToFill"
                                                                       Visibility="{x:Bind PreviewVisibility, Mode=OneWay}" />
                                                            </Grid>
                                                        </Border>

                                                        <TextBlock Grid.Row="1" Text="{x:Bind Title}"
                                                                   MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" />

                                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                                            <!-- 来源标签（v0.4.0）：工坊 / 系统 / 图片库 / 自定义 -->
                                                            <TextBlock Text="{x:Bind SourceLabel}"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                            <TextBlock Text="{x:Bind KindLabel}"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6" />
                                                            <!-- 含音轨标记：提醒「这张有声音，但默认是静音的」 -->
                                                            <TextBlock Text="♪"
                                                                       Visibility="{x:Bind AudioVisibility, Mode=OneWay}"
                                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                                                        </StackPanel>

                                                        <!-- 不可用原因：直接在条目里说清，而不是等点了才报错 -->
                                                        <TextBlock Grid.Row="3" Text="{x:Bind UnusableReason}"
                                                                   Visibility="{x:Bind UnusableVisibility, Mode=OneWay}"
                                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                   MaxLines="2" TextWrapping="Wrap"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>

                                        <!-- 空态引导（v0.4.0）：未装 WE / 目录为空 / 过滤无命中三种「没有条目」
                                             必须说清差别并给出怎么办，不能只留一片空白 -->
                                        <Border Visibility="{x:Bind ViewModel.LibraryEmptyVisibility, Mode=OneWay}"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4" Padding="16">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="库里还没有壁纸"
                                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind ViewModel.LibraryEmptyText, Mode=OneWay}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Opacity="0.8" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{x:Bind ViewModel.LibraryStatusText, Mode=OneWay}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Opacity="0.8" TextWrapping="Wrap" />

                                        <!-- 壁纸声音是全局软件设置，已移到「设置」页；
                                             这里留一行指路，避免用户在库里找开关找不到 -->
                                        <TextBlock Text="带 ♪ 的条目含音轨。是否发声是全局设置，见「设置」页 →「壁纸声音」（默认关闭）。"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Opacity="0.7" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- 未选中窗口时的占位 -->
                                <TextBlock Text="请先在左侧选择一个窗口"
                                           Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                                           Opacity="0.7"
                                           HorizontalAlignment="Center"
                                           Margin="0,32,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- FPS 性能监控悬浮显示（右上角） -->
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,8,16,0"
                                Padding="12,6"
                                CornerRadius="6"
                                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind ViewModel.FpsOverlayVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.FpsText, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </Border>
                    </Grid>
                        </Grid>

                <!-- ===== 设置页 / 关于页 ===== -->
                <pages:SettingsPage x:Name="SettingsPanel"
                                    ViewModel="{x:Bind ViewModel}"
                                    Visibility="Collapsed" />
                <pages:AboutPage x:Name="AboutPanel" Visibility="Collapsed" />

            </Grid>
        </NavigationView>
    </Grid>
</Window>

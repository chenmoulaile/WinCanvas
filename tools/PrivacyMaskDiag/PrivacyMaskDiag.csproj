<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 隐私窗口工作包的验证探针：alpha 遮蔽/恢复回读、前台监听 E2E、DWM 缩略图预览效果。
         不加入 WinCanvas.sln：避免污染基线 warning 门禁与测试口径（与 Wp1AHostDiag 同约定）；
         单独以 dotnet run（带项目路径参数）运行。TFM 与被测的 WinCanvas.Core 一致。 -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PrivacyMaskDiag</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- 被测对象：WinCanvas.Core（ForegroundWatcherService / PrivacyMaskRules / NativeMethods） -->
    <ProjectReference Include="..\..\src\WinCanvas.Core\WinCanvas.Core.csproj" />
  </ItemGroup>

</Project>
